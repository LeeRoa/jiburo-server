# ============================================================
# .env.example — 이 파일을 복사해서 .env로 만들고 값을 채우세요 (cp .env.example .env)
# - 로컬: ./gradlew bootRun 이 .env를 읽음 (IntelliJ에서 메인 클래스를 바로 실행하면 읽지 않음)
# - 운영: docker compose -f compose-prod.yaml 이 같은 폴더의 .env를 컨테이너에 전달
# - 값은 따옴표 없이 KEY=value 형식 권장 (감싼 따옴표는 bootRun에서 벗겨짐)
# .env는 .gitignore에 등록되어 있어 절대 커밋되지 않습니다
# ============================================================

# ── JWT ──────────────────────────────────────────────────────
# HS256 알고리즘 사용. 32자 이상 랜덤 문자열 입력
JWT_SECRET=your-jwt-secret-key-here-must-be-32-chars-or-more

# ── Google OAuth2 ─────────────────────────────────────────────
# console.cloud.google.com > 사용자 인증 정보 > OAuth 2.0 클라이언트 ID
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# ── Kakao OAuth2 ──────────────────────────────────────────────
# developers.kakao.com > 내 애플리케이션 > 앱 키 > REST API 키
KAKAO_CLIENT_ID=your-kakao-client-id
KAKAO_CLIENT_SECRET=your-kakao-client-secret

# ── Naver OAuth2 ──────────────────────────────────────────────
# developers.naver.com > 내 애플리케이션 > 애플리케이션 정보
NAVER_CLIENT_ID=your-naver-client-id
NAVER_CLIENT_SECRET=your-naver-client-secret

# ── Cloudflare R2 ─────────────────────────────────────────────
# Cloudflare 대시보드 > R2 > API 토큰
R2_ACCESS_KEY=your-r2-access-key
R2_SECRET_KEY=your-r2-secret-key
R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
R2_BUCKET_NAME=your-bucket-name
R2_PUBLIC_URL=https://your-r2-public-url

# ── CORS ─────────────────────────────────────────────────────
# 웹 프론트 origin (콤마 구분, REST CORS·WebSocket 공통). 이 줄을 지우거나 주석 처리하면 기본값(운영 도메인 + localhost:3000)
# (빈 값 "CORS_ALLOWED_ORIGINS=" 은 docker에서 "허용 없음"이 되므로 쓰지 말 것)
CORS_ALLOWED_ORIGINS=https://jiburo.on-do.kro.kr,http://localhost:3000

# ── 관리자 ───────────────────────────────────────────────────
# 초기 관리자 소셜 ID (콤마 구분, provider_id 형식). 로그인하면 SUPER_ADMIN 자동 부여
ADMIN_OAUTH_IDS=

# ── DB (운영 docker compose) ─────────────────────────────────
# 운영 MariaDB 비밀번호 (compose-prod.yaml의 ${DB_PASSWORD}). 로컬 bootRun은 compose-dev 기본값을 쓰므로 비워도 됨
DB_PASSWORD=

# ── 푸시 (FCM) ───────────────────────────────────────────────
# Firebase 서비스 계정 키. 둘 다 비우면 푸시를 보내지 않고 로그만 남김
# - FIREBASE_CREDENTIALS_PATH: 키 파일 경로 (로컬은 이쪽이 간편. 예: ./firebase-key.json — .gitignore에 추가할 것)
# - FIREBASE_CREDENTIALS_JSON: 키 JSON 내용을 한 줄로 (줄바꿈 없이)
FIREBASE_CREDENTIALS_PATH=
FIREBASE_CREDENTIALS_JSON=
